# Copy this file to .env.local in the project root and fill real values.
# start_all.ps1 loads .env.local automatically (or use -EnvFile).

# SMS provider: use "twilio" for live SMS, "console" for log-only fallback
SMS_PROVIDER=twilio

# Default country code for local numbers without + prefix
SMS_COUNTRY_CODE=+91

# Twilio credentials (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+14155552671
