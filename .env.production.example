# ==============================================================================
# AcuMeds Production Environment Variables Template
# Copy this file to .env.production and supply your real production secrets.
# IMPORTANT: Never commit your real API keys or secrets to public repositories!
# ==============================================================================

# Core Application Settings
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=generate_with_python_secrets_token_hex_32

# Production Host & Ports
HOST=0.0.0.0
PORT_PHARMACY=5000
PORT_SHOPKEEPER=5001
PORT_ADMIN=5002
PORT_DELIVERY=5003
PORT_DOCTOR=5004

# Database Connection
# Default SQLite (Persistent Volume):
# DATABASE_URL=sqlite:////app/admin_system/database/pharmacy.db
# Or PostgreSQL (Render / Railway / Supabase / AWS RDS):
# DATABASE_URL=postgresql://acumeds_user:strong_password@db-host:5432/acumeds_prod

# Manual UPI Payment Settings (Non-gateway 12-digit UTR settlement)
MANUAL_UPI_ID=avinashbarai722@okhdfcbank
MANUAL_UPI_NAME=AcuMeds Healthcare

# Automated Payment Gateway (Paytm - Optional)
PAYTM_ENV=prod
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=DEFAULT
PAYTM_CALLBACK_URL=https://your-domain.com/payment/callback
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE=Retail

# SMS Gateway (Delivery & Consultation OTP Verification)
# Options: "twilio" for real SMS, "console" for server-log OTP simulation
SMS_PROVIDER=console
SMS_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI Clinical Assistant & Chatbot (Optional OpenAI integration)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
